public static void main(String[] args) {
    // Setting up the canvas
    Turtle.setCanvasSize(800, 600);

    // Create different tasks
    Thread t1 = new Thread(new draw("red", -200, 0));
    Thread t2 = new Thread(new draw("blue", 200, 0));
    Thread t3 = new Thread(new draw("green", 0, 150));
    Thread t4 = new Thread(new draw("deeppink", 0, 0));

    // Start the threads (This calls the run() method in each task concurrently)
    t1.start();
    t2.start();
    t3.start();
    t4.start();
}
